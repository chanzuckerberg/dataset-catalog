# Catalog connection, read by the catalog CLI, the SDK, the catalog plugin, and generated
# registration scripts. Prefer exporting these from your shell init file (see the catalog docs' auth pages).
# Never commit real values.

# Catalog base URL; its host names the environment (dev, staging, or prod)
CATALOG_API_URL=
# API token issued at <CATALOG_API_URL>/tokens for that same catalog
CATALOG_API_TOKEN=
