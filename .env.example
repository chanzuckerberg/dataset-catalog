# Catalog credentials. Copy to .env (git-ignored) or set in your shell, scheduler secrets, or
# Claude Code environment settings. Never commit real values.

# catalog CLI and SDK examples: base URL plus a token for that same environment
CATALOG_API_URL=
CATALOG_API_TOKEN=

# catalog plugin scripts and generated registration scripts (--env staging|prod)
CATALOG_STAGING_API_TOKEN=
# Keep the production token out of interactive sessions; give it only to the production pipeline.
CATALOG_PROD_API_TOKEN=
